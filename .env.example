# Google reCAPTCHA v2 Keys
# Get these from: https://www.google.com/recaptcha/admin
# 1. Go to Google reCAPTCHA Console
# 2. Click "Create" to add a new site
# 3. Name: "Your Site Name"
# 4. reCAPTCHA Type: "reCAPTCHA v2" > "I'm not a robot" Checkbox
# 5. Domains: add your domain (localhost for local testing)
# 6. Copy the Site Key and Secret Key below

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Email Configuration (Gmail SMTP)
# 1. Use a Gmail app password (not your regular Gmail password)
# 2. Enable 2FA on your Google account
# 3. Generate an app password at: https://myaccount.google.com/apppasswords

SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Follow Up Boss Integration
# Get your API key from: https://www.followupboss.com/api
# This is optional - if not set, contacts will only be emailed

FUB_API_KEY=your_fub_api_key_here
